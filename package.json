{
  "name": "tinroof-timer",
  "productName": "TinRoof Timer",
  "version": "1.1.0",
  "description": "Cross-platform speaker countdown timer, protocol-compatible with Irisdown Countdown Timer 2.0 and Bitfocus Companion",
  "main": "src/main/main.js",
  "author": "BasilChessman",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder --mac --win"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.tinrooftimer.app",
    "productName": "TinRoof Timer",
    "files": ["src/**/*", "package.json"],
    "directories": { "output": "dist", "buildResources": "build" },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [{ "target": "dmg", "arch": ["universal"] }]
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }]
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "portable": { "artifactName": "${productName}-${version}-portable.exe" }
  }
}
